# ── Sanity CMS ────────────────────────────────────────────────────────────────
# Lấy tại: https://www.sanity.io/manage → chọn project → Settings → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Token dùng cho seed script và preview mode
# Lấy tại: sanity.io/manage → project → API → Tokens → Add API token (Editor)
SANITY_API_TOKEN=skXXXXXXXXXXXXXXXXXX

# ── Resend - Dịch vụ gửi email ────────────────────────────────────────────────
# Lấy tại: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL_TO=your@email.com

# ── URL website ────────────────────────────────────────────────────────────────
# Dùng cho metadata và sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ── Sanity Studio ──────────────────────────────────────────────────────────────
# Set "true" để bật /studio trên production (mặc định chỉ bật trên dev)
NEXT_PUBLIC_ENABLE_STUDIO=false
